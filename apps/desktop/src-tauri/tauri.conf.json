{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulso",
  "version": "0.1.0",
  "identifier": "com.renox.pulso",
  "build": {
    "beforeDevCommand": "pnpm --filter web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulso",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pulso"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Game",
    "shortDescription": "Tu mundo gaming en un solo lugar"
  }
}
